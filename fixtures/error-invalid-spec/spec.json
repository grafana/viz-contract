{
  "specVersion": 1,
  "panel": {
    "type": "grafana-echartscartesian-panel",
    "options": {
      "seriesType": "line"
    },
    "fieldConfig": {
      "defaults": {
        "unit": "reqps"
      }
    },
    "datasource": {
      "uid": "lgtm-prometheus"
    },
    "targets": [
      {
        "refId": "A",
        "expr": "sum by (handler) (rate(grafana_http_request_duration_seconds_count[5m]))",
        "legendFormat": "{{handler}}",
        "format": "time_series"
      }
    ]
  }
}
