      "description": "timeseries with chart options: carried options of each root, a default for an option that the panel does not have, a dropped option of options and of fieldConfig.defaults, an override with no carried property, and an override with a carried and a dropped property",
      "chart": "timeseries",
      "panel": {
        "type": "grafana-echartscartesian-panel",
        "options": {
          "seriesType": "line",
          "stacking": "normal",
          "lineWidth": 2,
          "legend": { "placement": "right" },
          "tooltip": { "mode": "multi" },
          "animation": { "enabled": false }
        },
        "fieldConfig": {
          "defaults": { "min": 0, "unit": "reqps", "custom": { "axisSoftMin": 0 } },
          "overrides": [
            {
              "matcher": { "id": "byFrameRefID", "options": "B" },
              "properties": [{ "id": "custom.axisSoftMin", "value": 5 }]
            },
            {
              "matcher": { "id": "byName", "options": "/api/health" },
              "properties": [
                { "id": "custom.lineStyle", "value": { "fill": "dash" } },
                { "id": "custom.axisSoftMin", "value": 1 }
              ]
            }
          ]
        }
      },
      "core": {
        "type": "timeseries",
        "pluginVersion": "12.3.0",
        "options": { "legend": { "showLegend": true, "placement": "right" }, "tooltip": { "mode": "multi" } },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "unit": "reqps",
            "custom": { "stacking": { "mode": "normal" }, "lineWidth": 2, "spanNulls": false }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "/api/health" },
              "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }]
            }
          ]
        }
      },
      "dropped": [
        "options.animation.enabled",
        "fieldConfig.defaults.custom.axisSoftMin",
        "fieldConfig.overrides[0].custom.axisSoftMin",
        "fieldConfig.overrides[1].custom.axisSoftMin"
      ]
    },
