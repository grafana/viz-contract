{
  "panel": {
    "type": "timeseries",
    "pluginVersion": "12.3.0",
    "options": {
      "legend": {
        "placement": "right"
      },
      "tooltip": {
        "mode": "multi"
      }
    },
    "fieldConfig": {
      "defaults": {
        "min": 0,
        "unit": "reqps",
        "custom": {
          "stacking": {
            "mode": "normal"
          },
          "lineWidth": 2
        }
      },
      "overrides": [
        {
          "matcher": {
            "id": "byName",
            "options": "/api/health"
          },
          "properties": [
            {
              "id": "custom.lineStyle",
              "value": {
                "fill": "dash"
              }
            }
          ]
        }
      ]
    }
  },
  "dropped": [
    "options.animation.enabled"
  ]
}
