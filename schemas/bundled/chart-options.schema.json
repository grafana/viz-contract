{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chart-options.json",
  "description": "The options of each chart that the model can set, and the version of each panel. The Renderer build writes this file.",
  "type": "object",
  "required": [
    "panels",
    "charts"
  ],
  "properties": {
    "panels": {
      "type": "object",
      "description": "The key is a panel ID of registry/panel-types.json.",
      "propertyNames": {
        "$ref": "#/$defs/tool-result.$defs.panelId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/panel"
      }
    },
    "charts": {
      "type": "object",
      "description": "The key is a chart name of registry/chart-types.json.",
      "propertyNames": {
        "$ref": "#/$defs/query-datasource-args.properties.type"
      },
      "additionalProperties": {
        "$ref": "#/$defs/chart"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "panel": {
      "type": "object",
      "required": [
        "pluginVersion"
      ],
      "properties": {
        "pluginVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "description": "The version of the panel: info.version of its built plugin.json. A version of Semantic Versioning 2.0.0, for example 0.4.1."
        }
      },
      "additionalProperties": false
    },
    "chart": {
      "type": "object",
      "required": [
        "options",
        "fieldConfig"
      ],
      "properties": {
        "options": {
          "type": "array",
          "description": "The panel options. A path starts at the options object of the panel.",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "fieldConfig": {
          "type": "array",
          "description": "The field options. A path starts at fieldConfig.defaults of the panel. It is also the id of an override property.",
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "path",
        "description",
        "tier",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
          "description": "The names of the keys from the root object to the value, joined with dots, for example legend.placement."
        },
        "description": {
          "type": "string",
          "pattern": "^\\S[^\\n\\r]*$",
          "description": "What the option changes in the chart, in one line."
        },
        "tier": {
          "enum": [
            "default",
            "advanced"
          ],
          "description": "advanced is an option that few charts need."
        },
        "default": {
          "description": "The value that the Renderer uses when the panel does not have the option. It validates against schema. With no default, the Renderer decides."
        },
        "schema": {
          "$ref": "#/$defs/valueSchema"
        }
      },
      "additionalProperties": false
    },
    "valueSchema": {
      "type": "object",
      "description": "The JSON Schema of the value of an option. It uses only these keywords, and it has no reference.",
      "properties": {
        "type": {
          "description": "One type, or a list of types for a value that can have more than one, for example a number or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/valueType"
            },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/valueType"
              }
            }
          ]
        },
        "anyOf": {
          "type": "array",
          "minItems": 2,
          "description": "The value validates against one or more of these schemas, for example a boolean or a number with a minimum.",
          "items": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "const": {},
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "items": {
          "$ref": "#/$defs/valueSchema"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "valueType": {
      "enum": [
        "boolean",
        "integer",
        "number",
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "tool-result.$defs.panelId": {
      "type": "string",
      "$comment": "Generated from registry/panel-types.json. Do not edit.",
      "enum": [
        "grafana-echartscartesian-panel",
        "grafana-echartsgauge-panel",
        "grafana-echartsgeo-panel",
        "grafana-echartsheatmap-panel",
        "grafana-echartshierarchy-panel",
        "grafana-echartsmultivariate-panel",
        "grafana-echartsparttowhole-panel",
        "grafana-relations-panel",
        "grafana-echartsstat-panel",
        "grafana-echartsstatetimeline-panel",
        "grafana-echartsstatushistory-panel",
        "grafana-echartsstream-panel"
      ]
    },
    "query-datasource-args.properties.type": {
      "type": "string",
      "$comment": "Generated from registry/chart-types.json. Do not edit.",
      "enum": [
        "timeseries",
        "barchart",
        "histogram",
        "candlestick",
        "boxplot",
        "piechart",
        "funnel",
        "heatmap",
        "geomap",
        "state-timeline",
        "status-history",
        "nodeGraph",
        "sankey",
        "chord",
        "treemap",
        "sunburst",
        "radar",
        "parallel",
        "streamgraph",
        "bubble",
        "gauge",
        "stat"
      ],
      "description": "Optional chart to draw. With no type, the chart comes from the data. get_chart_options gives the data that a chart needs."
    }
  },
  "$comment": "Generated from schemas/chart-options.schema.json. Do not edit."
}
