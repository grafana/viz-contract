{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viz spec",
  "description": "The JSON object that the App gives to the Renderer. The Renderer ignores fields that it does not know.",
  "type": "object",
  "required": [
    "specVersion",
    "panel",
    "data"
  ],
  "properties": {
    "specVersion": {
      "const": 1,
      "$comment": "Generated from registry/constants.json (specVersion). Do not edit."
    },
    "panel": {
      "type": "object",
      "description": "A Grafana panel JSON. type, title, options and fieldConfig come from the panel of the tool result. datasource and targets come from the tool arguments.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "tool-result.schema.json#/$defs/panelId"
        },
        "title": {
          "$ref": "tool-result.schema.json#/$defs/panel/properties/title"
        },
        "options": {
          "type": "object"
        },
        "fieldConfig": {
          "$ref": "tool-result.schema.json#/$defs/panel/properties/fieldConfig"
        },
        "datasource": {
          "$ref": "#/$defs/datasourceRef"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "refId"
            ],
            "properties": {
              "refId": {
                "type": "string"
              },
              "datasource": {
                "$ref": "#/$defs/datasourceRef"
              }
            }
          }
        }
      }
    },
    "data": {
      "$ref": "tool-result.schema.json#/$defs/data"
    },
    "notices": {
      "type": "array",
      "description": "Notices of the App, for example chart-changed. The Renderer shows them with its own notices.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark"
    },
    "timeZone": {
      "type": "string",
      "default": "browser",
      "description": "browser, utc, or an IANA time zone name, for example Europe/Paris."
    },
    "grafanaUrl": {
      "type": "string",
      "format": "uri",
      "description": "The base URL of the Grafana that ran the query."
    },
    "filters": {
      "$ref": "query-datasource-args.schema.json#/properties/filters",
      "description": "The ad-hoc filters of the tool result. With this field, the Renderer can show the ad-hoc filter buttons."
    }
  },
  "$defs": {
    "datasourceRef": {
      "type": "object",
      "required": [
        "uid"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        }
      }
    }
  }
}
