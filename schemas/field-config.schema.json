{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fieldConfig of the query_datasource arguments",
  "description": "The form of the fieldConfig of the tool arguments. The schema of the tool arguments does not hold this form, so the tool list of a Host stays small. The Source checks it.",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "object",
      "description": "The field options of all fields."
    },
    "overrides": {
      "type": "array",
      "description": "The field options of some fields.",
      "items": {
        "type": "object",
        "required": [
          "matcher",
          "properties"
        ],
        "properties": {
          "matcher": {
            "type": "object",
            "required": [
              "id",
              "options"
            ],
            "properties": {
              "id": {
                "enum": [
                  "byName",
                  "byRegexp",
                  "byFrameRefID"
                ]
              },
              "options": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "value"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The path of a field option."
                },
                "value": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
